<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="aesth_clic.Views.Roles.Admin.Pages.AdminDashboard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:aesth_clic.Views.Roles.Admin.Pages"
  xmlns:vm="using:aesth_clic.ViewModels.Admin"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="#F7F4FD"
>
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White" />
            <Setter Property="BorderBrush"     Value="#E4DAF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20" />
        </Style>

        <!-- Transparent clickable button wrapper for KPI cards -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background"               Value="Transparent" />
            <Setter Property="BorderBrush"              Value="Transparent" />
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Padding"                  Value="0" />
            <Setter Property="HorizontalAlignment"      Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius"             Value="12" />
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2D1554" />
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
        </Style>

        <Style x:Key="KpiSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="12" />
            <Setter Property="Foreground" Value="#B0A0CC" />
            <Setter Property="Margin"    Value="0,3,0,0" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2D1554" />
        </Style>

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="12" />
            <Setter Property="Foreground" Value="#9B80C4" />
            <Setter Property="Margin"    Value="0,2,0,0" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="10" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- Root grid so ToastBar can float -->
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="28,24,28,32" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- PAGE HEADER -->
                <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,4">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#2D1554" />
                    <TextBlock
                        Text="Welcome back — here's your clinic overview for today."
                        FontSize="13" Foreground="#9B80C4" />
                </StackPanel>

                <!-- KPI CARDS -->
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Patients -->
                    <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Click="KpiCard_Click">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="0">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="#F8E0F9">
                                        <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="#9B1DAF" />
                                    </Border>
                                    <TextBlock
                                        Text="TOTAL PATIENTS"
                                        Style="{StaticResource KpiLabelStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtTotalPatients" Text="—" Style="{StaticResource KpiValueStyle}" />
                                <TextBlock Text="Registered patients" Style="{StaticResource KpiSubStyle}" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Card 2: Monthly Revenue -->
                    <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Click="KpiCard_Click">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="0">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="#DDEEFF">
                                        <FontIcon Glyph="&#xE8A4;" FontSize="16" Foreground="#0063B1" />
                                    </Border>
                                    <TextBlock
                                        Text="MONTHLY REVENUE"
                                        Style="{StaticResource KpiLabelStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtMonthlyRevenue" Text="—" Style="{StaticResource KpiValueStyle}" />
                                <TextBlock Text="Total paid payments this month" Style="{StaticResource KpiSubStyle}" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Card 3: Low Stock Count -->
                    <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Click="KpiCard_Click">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="0">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="#FDECEA">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#C0392B" />
                                    </Border>
                                    <TextBlock
                                        Text="LOW STOCK ALERTS"
                                        Style="{StaticResource KpiLabelStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtLowStockKpi" Text="—" Style="{StaticResource KpiValueStyle}" />
                                <TextBlock Text="Medicines below threshold (10)" Style="{StaticResource KpiSubStyle}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

                <!-- BOTTOM: Procedures + Low Stock -->
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Procedure Statistics -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Procedure Statistics" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Most common this month" Style="{StaticResource CardSubtitleStyle}" />
                            </StackPanel>

                            <ItemsControl x:Name="ProcedureListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProcedureStatItem">
                                        <StackPanel Spacing="14" Margin="0,0,0,14">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind ProcedureName}"
                                                        FontSize="13" Foreground="#2D1554" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Count}"
                                                        FontSize="13" Foreground="#5B2D8E" FontWeight="SemiBold" />
                                                </Grid>
                                                <ProgressBar
                                                    Value="{x:Bind BarPercent}"
                                                    Maximum="100"
                                                    Foreground="#5B2D8E"
                                                    Background="#EDE4F9"
                                                    CornerRadius="3"
                                                    Height="7" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="TxtNoProcedures"
                                Text="No procedures recorded this month."
                                FontSize="13" Foreground="#9B80C4"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Low Stock Alert -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Low Stock Alert" Style="{StaticResource CardTitleStyle}" />
                                    <Border
                                        Background="#FDECEA"
                                        CornerRadius="5"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtLowStockCount"
                                            Text="—"
                                            FontSize="11" Foreground="#C0392B" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Text="Medicines below reorder threshold (stock &lt; 10)"
                                    Style="{StaticResource CardSubtitleStyle}" />
                            </StackPanel>

                            <!-- Column headers -->
                            <Border Background="#FEF5F4" CornerRadius="8" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MEDICINE"  Style="{StaticResource ColHeaderStyle}" Foreground="#C0392B" />
                                    <TextBlock Grid.Column="1" Text="STOCK"     Style="{StaticResource ColHeaderStyle}" Foreground="#C0392B" />
                                    <TextBlock Grid.Column="2" Text="THRESHOLD" Style="{StaticResource ColHeaderStyle}" Foreground="#C0392B" />
                                </Grid>
                            </Border>

                            <!-- Dynamic low stock rows -->
                            <ItemsControl x:Name="LowStockListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LowStockItem">
                                        <StackPanel>
                                            <Border Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="{x:Bind DotColor}" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            FontSize="13" Foreground="#2D1554"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind StockDisplay}"
                                                        FontSize="13" Foreground="#C0392B" FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind ThresholdDisplay}"
                                                        FontSize="13" Foreground="#9B80C4"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Height="1" Background="#F0EAF8" Margin="14,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="TxtNoLowStock"
                                Text="All medicines are sufficiently stocked."
                                FontSize="13" Foreground="#9B80C4"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="LowStockAlertPanel"
                                Background="#FEF0EF"
                                BorderBrush="#F5C6C2"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE7BA;"
                                        FontSize="13" Foreground="#C0392B"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="TxtLowStockAlert"
                                        FontSize="12" Foreground="#C0392B"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Floating ToastBar -->
        <InfoBar
            x:Name="ToastBar"
            IsOpen="False"
            IsClosable="True"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="28,8,28,0" />

    </Grid>
</Page>