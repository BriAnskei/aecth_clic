<ContentDialog
    x:Class="aesth_clic.Views.Roles.SuperAdmin.Modals.ConfirmMarkAsPaid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm Payment"
    PrimaryButtonText="Confirm Payment"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnConfirmClicked">

    <ContentDialog.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin"     Value="0,2,0,0" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="380">

        <!-- Descriptive prompt -->
        <TextBlock
            Text="You are about to mark the following subscription as paid. Please review the details before confirming."
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!-- Detail card -->
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            <Grid ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Client -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="0">
                    <TextBlock Text="CLIENT" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="TextClientName" Style="{StaticResource ValueStyle}" />
                </StackPanel>

                <!-- Clinic -->
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                    <TextBlock Text="CLINIC" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="TextClinicName" Style="{StaticResource ValueStyle}" />
                </StackPanel>

                <!-- Amount -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="0">
                    <TextBlock Text="AMOUNT DUE" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="TextAmount"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#0078D4"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Due Date -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                    <TextBlock Text="DUE DATE" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="TextDueDate" Style="{StaticResource ValueStyle}" />
                </StackPanel>

            </Grid>
        </Border>

    </StackPanel>

</ContentDialog>
