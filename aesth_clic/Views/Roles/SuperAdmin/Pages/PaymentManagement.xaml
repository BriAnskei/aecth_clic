<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="aesth_clic.Views.Roles.SuperAdmin.Pages.PaymentManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.SuperAdmin.Pages"
    xmlns:vm="using:aesth_clic.ViewModels.SuperAdmin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush"     Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="20" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="13" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,4,0,0" />
        </Style>

        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TableSubCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <!-- Skeleton block placeholder -->
        <Style x:Key="SkeletonBlockStyle" TargetType="Border">
            <Setter Property="Background"        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius"      Value="4" />
            <Setter Property="Height"            Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Page.Resources>

    <!-- Root grid so ToastBar can float over the page -->
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="24" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════
                     ROW 0 · Page Header
                ══════════════════════════════════ -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        Text="Payment Management"
                        FontSize="24" FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="Monthly Subscriptions · Aesthetic Clinic ERP"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- ══════════════════════════════════
                     ROW 1 · Toast InfoBar
                ══════════════════════════════════ -->
                <InfoBar Grid.Row="1"
                         x:Name="ToastBar"
                         IsOpen="False"
                         IsClosable="True"
                         Margin="0,-8,0,-8" />

                <!-- ══════════════════════════════════
                     ROW 2 · KPI Cards
                ══════════════════════════════════ -->
                <Grid Grid.Row="2" x:Name="KpiGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- MRR -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A4;" FontSize="16" Foreground="#0078D4" />
                                    <TextBlock Text="MRR" Style="{StaticResource SectionHeaderStyle}" />
                                </StackPanel>
                                <TextBlock Text="Monthly Recurring Revenue" Style="{StaticResource KpiLabelStyle}" />
                                <TextBlock x:Name="TxtSubscriberCount"
                                           Text="0 active subscribers"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="TxtMrr"
                                       Text="₱0.00"
                                       Style="{StaticResource KpiValueStyle}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Collected This Month -->
                    <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#0EA47A" />
                                    <TextBlock Text="COLLECTED THIS MONTH" Style="{StaticResource SectionHeaderStyle}" />
                                </StackPanel>
                                <TextBlock Text="Payments received this month" Style="{StaticResource KpiLabelStyle}" />
                                <TextBlock x:Name="TxtCollectionRate"
                                           Text="0% collection rate"
                                           FontSize="12" Foreground="#0EA47A" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="TxtCollected"
                                       Text="₱0.00"
                                       Style="{StaticResource KpiValueStyle}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Overdue -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#D83B01" />
                                    <TextBlock Text="OVERDUE" Style="{StaticResource SectionHeaderStyle}" />
                                </StackPanel>
                                <TextBlock Text="Unpaid past due date" Style="{StaticResource KpiLabelStyle}" />
                                <TextBlock x:Name="TxtOverdueCount"
                                           Text="0 overdue invoices"
                                           FontSize="12" Foreground="#D83B01" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="TxtOverdue"
                                       Text="₱0.00"
                                       Style="{StaticResource KpiValueStyle}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════
                     ROW 3 · Search + Filter Toolbar
                ══════════════════════════════════ -->
                <Grid Grid.Row="3" x:Name="FilterToolbar" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        Grid.Column="0"
                        x:Name="SearchBox"
                        PlaceholderText="Search name, email, or clinic…"
                        QueryIcon="Find"
                        VerticalAlignment="Center"
                        TextChanged="SearchBox_TextChanged" />

                    <ComboBox
                        Grid.Column="1"
                        x:Name="StatusFilter"
                        PlaceholderText="All Status"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="All Status" Tag="All" />
                        <ComboBoxItem Content="Paid"       Tag="Paid" />
                        <ComboBoxItem Content="Due Soon"   Tag="Due Soon" />
                        <ComboBoxItem Content="Overdue"    Tag="Overdue" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="2"
                        x:Name="TierFilter"
                        PlaceholderText="All Tiers"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="TierFilter_SelectionChanged">
                        <ComboBoxItem Content="All Tiers" Tag="All" />
                        <ComboBoxItem Content="Basic"     Tag="basic" />
                        <ComboBoxItem Content="Standard"  Tag="standard" />
                        <ComboBoxItem Content="Premium"   Tag="premium" />
                    </ComboBox>
                </Grid>

                <!-- ══════════════════════════════════
                     ROW 4 · Row count label
                ══════════════════════════════════ -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtRowCount"
                               Text="0 invoices"
                               Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- ══════════════════════════════════
                     ROW 5 · Table area
                ══════════════════════════════════ -->
                <Grid Grid.Row="5">

                    <!-- ── SKELETON TABLE ── -->
                    <Border x:Name="SkeletonTable"
                            Visibility="Visible"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <!-- Skeleton header bar -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8,8,0,0" Padding="20,12" Height="44" />

                            <!-- 5 skeleton rows -->
                            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,0">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="120" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="160" HorizontalAlignment="Left" Height="10" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlockStyle}" Width="140" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Width="60"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBlockStyle}" Width="70"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="4" Style="{StaticResource SkeletonBlockStyle}" Width="80"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="5" Style="{StaticResource SkeletonBlockStyle}" Width="80"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="6" Style="{StaticResource SkeletonBlockStyle}" Width="60"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="7" Style="{StaticResource SkeletonBlockStyle}" Width="24"  HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,0">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="100" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="150" HorizontalAlignment="Left" Height="10" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlockStyle}" Width="160" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Width="70"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBlockStyle}" Width="65"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="4" Style="{StaticResource SkeletonBlockStyle}" Width="85"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="5" Style="{StaticResource SkeletonBlockStyle}" Width="75"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="6" Style="{StaticResource SkeletonBlockStyle}" Width="55"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="7" Style="{StaticResource SkeletonBlockStyle}" Width="24"  HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,0">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="130" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="145" HorizontalAlignment="Left" Height="10" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlockStyle}" Width="130" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Width="55"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBlockStyle}" Width="75"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="4" Style="{StaticResource SkeletonBlockStyle}" Width="90"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="5" Style="{StaticResource SkeletonBlockStyle}" Width="80"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="6" Style="{StaticResource SkeletonBlockStyle}" Width="65"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="7" Style="{StaticResource SkeletonBlockStyle}" Width="24"  HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,0">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="110" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="155" HorizontalAlignment="Left" Height="10" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlockStyle}" Width="150" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Width="65"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBlockStyle}" Width="70"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="4" Style="{StaticResource SkeletonBlockStyle}" Width="78"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="5" Style="{StaticResource SkeletonBlockStyle}" Width="82"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="6" Style="{StaticResource SkeletonBlockStyle}" Width="58"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="7" Style="{StaticResource SkeletonBlockStyle}" Width="24"  HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Padding="20,0">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="115" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SkeletonBlockStyle}" Width="140" HorizontalAlignment="Left" Height="10" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlockStyle}" Width="120" HorizontalAlignment="Left" />
                                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Width="60"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="3" Style="{StaticResource SkeletonBlockStyle}" Width="68"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="4" Style="{StaticResource SkeletonBlockStyle}" Width="88"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="5" Style="{StaticResource SkeletonBlockStyle}" Width="78"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="6" Style="{StaticResource SkeletonBlockStyle}" Width="62"  HorizontalAlignment="Left" />
                                    <Border Grid.Column="7" Style="{StaticResource SkeletonBlockStyle}" Width="24"  HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── REAL TABLE ── -->
                    <Border x:Name="RealTable"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Column Headers -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="20,14,20,14"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CLIENT"         Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="1" Text="CLINIC"         Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="TIER"           Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="MONTHLY AMOUNT" Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="4" Text="NEXT DUE"       Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="5" Text="SINCE"          Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="6" Text="STATUS"         Style="{StaticResource TableHeaderStyle}" />
                                    <TextBlock Grid.Column="7" Text=""               Style="{StaticResource TableHeaderStyle}" />
                                </Grid>
                            </Border>

                            <!-- Scrollable rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PaymentListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SubscriptionItem">
                                            <Border BorderThickness="0,0,0,1"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    Padding="20,14,20,14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- CLIENT: Name + Email -->
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FullName}"
                                                                   Style="{StaticResource TableCellStyle}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Email}"
                                                                   Style="{StaticResource TableSubCellStyle}" />
                                                    </StackPanel>

                                                    <!-- CLINIC -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind ClinicName}"
                                                               Style="{StaticResource TableCellStyle}" />

                                                    <!-- TIER badge -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind TierDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{x:Bind TierForeground}"
                                                               VerticalAlignment="Center" />

                                                    <!-- MONTHLY AMOUNT -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{x:Bind MonthlyAmountDisplay}"
                                                               Style="{StaticResource TableCellStyle}" />

                                                    <!-- NEXT DUE (EndDate, coloured by status) -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{x:Bind EndDateDisplay}"
                                                               FontSize="13"
                                                               Foreground="{x:Bind NextDueForeground}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- SINCE (StartDate) -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{x:Bind StartDateDisplay}"
                                                               Style="{StaticResource TableSubCellStyle}" />

                                                    <!-- STATUS badge: icon + text -->
                                                    <StackPanel Grid.Column="6"
                                                                Orientation="Horizontal" Spacing="5"
                                                                VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind StatusIcon}"
                                                                  FontSize="10"
                                                                  Foreground="{x:Bind StatusForeground}" />
                                                        <TextBlock Text="{x:Bind DisplayStatus}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{x:Bind StatusForeground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- ACTIONS kebab -->
                                                    <Button Grid.Column="7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Padding="8,4"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            ToolTipService.ToolTip="More actions">
                                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuFlyoutItem Text="Mark Current Month as Paid"
                                                                                Click="MarkAsPaid_Click"
                                                                                DataContext="{x:Bind}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE73E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Generate Receipt"
                                                                                Click="GenerateReceipt_Click"
                                                                                DataContext="{x:Bind}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8B7;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Footer -->
                            <Border Grid.Row="2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="0,0,8,8" Padding="20,10">
                                <TextBlock x:Name="TxtFooterCount"
                                           Text="Showing 0 invoices"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
