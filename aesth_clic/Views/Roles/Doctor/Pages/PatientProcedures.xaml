<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="aesth_clic.Views.Roles.Doctor.Pages.PatientProcedures"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Doctor.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F7F4FD">

    <Page.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White" />
            <Setter Property="BorderBrush"     Value="#E4DAF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="12" />
            <Setter Property="Padding"         Value="20" />
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="KpiSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Foreground" Value="#B0A0CC" />
            <Setter Property="Margin"     Value="0,3,0,0" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,24,28,32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- ROW 0 · Header -->
                <RowDefinition Height="Auto" />
                <!-- ROW 1 · KPI Cards -->
                <RowDefinition Height="Auto" />
                <!-- ROW 2 · Search + Filter -->
                <RowDefinition Height="Auto" />
                <!-- ROW 3 · Table -->
                <RowDefinition Height="Auto" />
                <!-- ROW 4 · Toast -->
            </Grid.RowDefinitions>

            <!-- ROW 0 · Page Header -->
            <Grid Grid.Row="0">
                <StackPanel Spacing="2">
                    <TextBlock Text="Patient Procedures"
                               FontSize="26" FontWeight="Bold" Foreground="#2D1554" />
                    <TextBlock Text="View and schedule appointments for patient procedures"
                               FontSize="13" Foreground="#9B80C4" />
                </StackPanel>
            </Grid>

            <!-- ROW 1 · KPI Cards -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#EDE4F9">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#5B2D8E" />
                                </Border>
                                <TextBlock Text="TOTAL" Style="{StaticResource KpiLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtTotalProcedures" Text="0"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#2D1554" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="All patient procedures" Style="{StaticResource KpiSubStyle}" />
                    </StackPanel>
                </Border>

                <!-- Pending -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FFF8E1">
                                    <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="#F59E0B" />
                                </Border>
                                <TextBlock Text="PENDING" Style="{StaticResource KpiLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtPendingProcedures" Text="0"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#2D1554" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Awaiting appointment" Style="{StaticResource KpiSubStyle}" />
                    </StackPanel>
                </Border>

                <!-- Scheduled -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#E3F2FD">
                                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="#0078D4" />
                                </Border>
                                <TextBlock Text="SCHEDULED" Style="{StaticResource KpiLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtScheduledProcedures" Text="0"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#2D1554" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Appointment set" Style="{StaticResource KpiSubStyle}" />
                    </StackPanel>
                </Border>

                <!-- Completed -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#E8F5E9">
                                    <FontIcon Glyph="&#xE930;" FontSize="16" Foreground="#2E7D32" />
                                </Border>
                                <TextBlock Text="COMPLETED" Style="{StaticResource KpiLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtCompletedProcedures" Text="0"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#2D1554" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Procedures done" Style="{StaticResource KpiSubStyle}" />
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ROW 2 · Search + Filter Toolbar -->
            <Border Grid.Row="2"
                    Background="White" BorderBrush="#E4DAF5"
                    BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        Grid.Column="0"
                        x:Name="SearchBox"
                        PlaceholderText="Search patient name or procedure…"
                        QueryIcon="Find"
                        VerticalAlignment="Center"
                        BorderBrush="#C4B0E0" BorderThickness="1" CornerRadius="8"
                        TextChanged="SearchBox_TextChanged" />

                    <ComboBox
                        Grid.Column="1"
                        x:Name="StatusFilter"
                        PlaceholderText="All Statuses"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        BorderBrush="#C4B0E0" CornerRadius="8"
                        SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="ComboBoxPlaceholderForeground"  Color="#9B80C4" />
                            <SolidColorBrush x:Key="ComboBoxBorderBrush"            Color="#C4B0E0" />
                            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5B2D8E" />
                            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused"     Color="#5B2D8E" />
                            <SolidColorBrush x:Key="ComboBoxBackground"             Color="White" />
                            <SolidColorBrush x:Key="ComboBoxForeground"             Color="#2D1554" />
                        </ComboBox.Resources>
                        <ComboBoxItem Content="All Statuses" Tag="All"       IsSelected="True" />
                        <ComboBoxItem Content="Pending"      Tag="Pending" />
                        <ComboBoxItem Content="Scheduled"    Tag="Scheduled" />
                        <ComboBoxItem Content="Completed"    Tag="Completed" />
                        <ComboBoxItem Content="Cancelled"    Tag="Cancelled" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ROW 3 · Procedures Table -->
            <Border Grid.Row="3"
                    Background="White" BorderBrush="#E4DAF5"
                    BorderThickness="1" CornerRadius="12" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Padding="20,16,20,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Procedure Records" FontSize="15" FontWeight="SemiBold" Foreground="#2D1554" />
                            <TextBlock Text="All patient procedures assigned to you" FontSize="12" Foreground="#9B80C4" />
                        </StackPanel>
                    </Grid>

                    <!-- Column Headers -->
                    <Grid Grid.Row="1">
                        <Border Background="#F7F4FD" Padding="20,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PATIENT"              Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="PROCEDURE"            Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="STATUS"               Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="APPOINTMENT SCHEDULE" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="PROCEDURE SCHEDULE"   Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="COST"                 Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="ACTIONS"              Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Height="1" Background="#E4DAF5" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Data Rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                        <ItemsControl x:Name="ProcedureListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PatientProcedureItem">
                                    <StackPanel>
                                        <Border Padding="20,0">
                                            <Grid MinHeight="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Patient Name + Avatar -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Width="36" Height="36" CornerRadius="18"
                                                            Background="{x:Bind AvatarColor}">
                                                        <TextBlock Text="{x:Bind Initials}"
                                                                   FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind PatientName}"
                                                               Style="{StaticResource CellTextStyle}" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <!-- Procedure Name -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind ProcedureName}"
                                                           Style="{StaticResource CellTextStyle}" />

                                                <!-- Status -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Status}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{x:Bind StatusBadgeForeground}"
                                                           VerticalAlignment="Center" />

                                                <!-- Appointment Schedule -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind AppointmentSchedule}"
                                                               Style="{StaticResource CellSecondaryStyle}"
                                                               Visibility="{x:Bind HasAppointmentDate}" />
                                                    <TextBlock Text="Not scheduled"
                                                               FontSize="11" Foreground="#B0A0CC" FontStyle="Italic"
                                                               Visibility="{x:Bind NoAppointmentDate}" />
                                                </StackPanel>

                                                <!-- Procedure Schedule -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind ProcedureSchedule}"
                                                               Style="{StaticResource CellSecondaryStyle}"
                                                               Visibility="{x:Bind HasProcedureDate}" />
                                                    <TextBlock Text="Not scheduled"
                                                               FontSize="11" Foreground="#B0A0CC" FontStyle="Italic"
                                                               Visibility="{x:Bind NoProcedureDate}" />
                                                </StackPanel>

                                                <!-- Cost -->
                                                <TextBlock Grid.Column="5" Text="{x:Bind Cost}"
                                                           Style="{StaticResource CellTextStyle}" FontWeight="SemiBold" />

                                                <!-- Kebab Menu -->
                                                <Border Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button
                                                        Tag="{x:Bind ProcedureRecordId}"
                                                        Padding="8,5" Background="Transparent"
                                                        CornerRadius="6" BorderThickness="0"
                                                        ToolTipService.ToolTip="Actions">
                                                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="#5B2D8E" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">

                                                                <!-- View (always enabled, placeholder) -->
                                                                <MenuFlyoutItem
                                                                    Text="View"
                                                                    Tag="{x:Bind ProcedureRecordId}"
                                                                    Click="ViewProcedure_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8A5;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>

                                                                <!-- Schedule (disabled when already scheduled) -->
                                                                <MenuFlyoutItem
                                                                    Text="Schedule"
                                                                    Tag="{x:Bind ProcedureRecordId}"
                                                                    IsEnabled="{x:Bind IsSchedulable}"
                                                                    Click="ScheduleAppointment_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE787;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>

                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Border>

                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="20,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3" Background="#F7F4FD" CornerRadius="0,0,12,12" Padding="20,10">
                        <TextBlock x:Name="TxtRowCount" Text="Showing 0 procedures"
                                   FontSize="12" Foreground="#5B2D8E" FontWeight="SemiBold" />
                    </Border>

                </Grid>
            </Border>

            <!-- ROW 4 · Toast -->
            <InfoBar Grid.Row="4" x:Name="ToastBar"
                     IsOpen="False" IsClosable="True" Margin="0,4,0,0" />

        </Grid>
    </ScrollViewer>
</Page>
