<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Doctor.Modals.ViewAppointmentDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Appointment Details"
    CloseButtonText="Close"
    DefaultButton="Close"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"           Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"          Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground" Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground" Color="White" />

        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
            <Setter Property="Margin"           Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9B80C4" />
            <Setter Property="Margin"     Value="0,0,0,2" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Foreground" Value="#2D1554" />
        </Style>

        <Style x:Key="ReadOnlyBoxStyle" TargetType="Border">
            <Setter Property="Background"      Value="#F7F4FD" />
            <Setter Property="BorderBrush"     Value="#E4DAF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="6" />
            <Setter Property="Padding"         Value="10,8" />
            <Setter Property="MinHeight"       Value="34" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="460">

        <!-- Patient -->
        <StackPanel Spacing="4">
            <TextBlock Text="PATIENT" Style="{StaticResource SectionLabelStyle}" />
            <Border Style="{StaticResource ReadOnlyBoxStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        x:Name="PatientAvatarBorder"
                        Width="28" Height="28" CornerRadius="14"
                        Background="#5B2D8E">
                        <TextBlock
                            x:Name="TxtInitials"
                            Text="?"
                            FontSize="11" FontWeight="SemiBold" Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        x:Name="TxtPatientName"
                        Text="—"
                        FontSize="13" FontWeight="SemiBold" Foreground="#2D1554"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Divider -->
        <Border Height="1" Background="#E4DAF5" />

        <!-- Procedure + Status row -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Procedure Name -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="PROCEDURE" Style="{StaticResource SectionLabelStyle}" />
                <Border Style="{StaticResource ReadOnlyBoxStyle}">
                    <TextBlock x:Name="TxtProcedureName" Text="—" Style="{StaticResource FieldValueStyle}" />
                </Border>
            </StackPanel>

            <!-- Status Badge -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="STATUS" Style="{StaticResource SectionLabelStyle}" />
                <Border x:Name="StatusBadge" CornerRadius="6" Padding="12,8" VerticalAlignment="Top">
                    <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Border Height="1" Background="#E4DAF5" />

        <!-- Dates row -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Appointment Date -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="APPOINTMENT DATE" Style="{StaticResource SectionLabelStyle}" />
                <Border Style="{StaticResource ReadOnlyBoxStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#5B2D8E" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtAppointmentDate" Text="—" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Procedure Date -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="PROCEDURE DATE" Style="{StaticResource SectionLabelStyle}" />
                <Border Style="{StaticResource ReadOnlyBoxStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#5B2D8E" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtProcedureDate" Text="—" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </StackPanel>
</ContentDialog>
