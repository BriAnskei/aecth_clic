<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Doctor.Modals.ViewProcedureModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Doctor.Modals"
    CloseButtonText="Close"
    DefaultButton="Close"
    CloseButtonClick="OnCloseClicked"
    PrimaryButtonClick="OnSaveClicked"
    PrimaryButtonStyle="{StaticResource PurplePrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="10" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="Foreground"   Value="#2D1554" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="HorizontalAlignment"        Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="28" />
            <Setter Property="Height"          Value="28" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"     Value="#E4DAF5" />
            <Setter Property="Background"      Value="White" />
            <Setter Property="CornerRadius"    Value="6" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Foreground"      Value="#5B2D8E" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="520">

        <!-- ── Patient Header ── -->
        <Border Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="PatientAvatar"
                        Width="48" Height="48" CornerRadius="24"
                        Background="#5B2D8E">
                    <TextBlock x:Name="PatientInitials"
                               FontSize="16" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="PATIENT" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock x:Name="TxtPatientName"
                               FontSize="16" FontWeight="Bold" Foreground="#2D1554" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D5;" FontSize="10" Foreground="#5B2D8E" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtProcedureName"
                                   FontSize="12" Foreground="#5B2D8E" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        x:Name="StatusBadge"
                        Background="#FFF8E1" CornerRadius="20" Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus"
                               FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                </Border>
            </Grid>
        </Border>

        <!-- ── Procedure Info Grid ── -->
        <Border Background="White" BorderBrush="#E4DAF5" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <Grid RowSpacing="14" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                    <TextBlock Text="ASSIGNED DOCTOR" Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="#9B80C4" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtAssignedDoctor" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                    <TextBlock Text="APPOINTMENT DATE" Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="#9B80C4" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtAppointmentDate" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="3">
                    <TextBlock Text="PROCEDURE DATE" Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="#9B80C4" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtProcedureDate" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                    <TextBlock Text="COST" Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BF;" FontSize="12" Foreground="#9B80C4" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtCost" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                    <TextBlock Text="CREATED" Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="#9B80C4" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtCreatedAt" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- PRESCRIPTION SECTION (only shown when Status == Completed)        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="PrescriptionSection"
                Visibility="Collapsed"
                Background="White" BorderBrush="#E4DAF5" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 0: header -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: view mode table -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: edit mode list -->
                    <RowDefinition Height="Auto" />
                    <!-- 3: cancel edit row -->
                    <RowDefinition Height="Auto" />
                    <!-- 4: error bar -->
                    <RowDefinition Height="Auto" />
                    <!-- 5: success bar -->
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Padding="16,14,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Prescription"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Medicines prescribed for this procedure"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="PrescriptionStatusBadge"
                                Background="#FFF8E1" CornerRadius="10" Padding="10,3">
                            <TextBlock x:Name="TxtPrescriptionStatus"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                        </Border>
                        <Button x:Name="BtnEditPrescription"
                                Visibility="Collapsed"
                                Click="OnEditPrescriptionClicked"
                                Padding="10,5" Background="#EDE4F9"
                                CornerRadius="6" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="#5B2D8E" />
                                <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" Foreground="#5B2D8E" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── VIEW MODE ── -->
                <Border x:Name="ViewModePanel" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F7F4FD" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"  />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MEDICINE" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="UNIT"     Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="QTY"      Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsControl Grid.Row="1" x:Name="PrescriptionViewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PrescriptionMedicineViewItem">
                                    <StackPanel>
                                        <Border Padding="16,0">
                                            <Grid MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"  />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="#5B2D8E" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource CellTextStyle}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{x:Bind Unit}"
                                                           Style="{StaticResource CellSecondaryStyle}"
                                                           HorizontalAlignment="Center" />

                                                <Border Grid.Column="2"
                                                        Background="#EDE4F9" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind QuantityDisplay}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#5B2D8E"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ── EDIT MODE ── -->
                <Border x:Name="EditModePanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="16,0,16,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                Grid.Column="0"
                                x:Name="EditMedicineSearchBox"
                                PlaceholderText="Search medicine…"
                                QueryIcon="Find"
                                BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                                TextChanged="EditMedicineSearch_TextChanged" />
                            <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10"
                                    Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEditSelectedCount" Text="0 selected"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="#F7F4FD" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"   />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MEDICINE" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="QUANTITY"
                                           Style="{StaticResource ColHeaderStyle}"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                            <ItemsControl x:Name="EditMedicineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:MedicineRowItem">
                                        <StackPanel>
                                            <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                                <Grid MinHeight="56">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"   />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button
                                                        Grid.Column="0"
                                                        Tag="{x:Bind MedicineIdTag}"
                                                        Style="{StaticResource RowButtonStyle}"
                                                        Click="EditMedicineRow_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <Border
                                                                Width="20" Height="20" CornerRadius="4"
                                                                BorderBrush="#C4A8E8" BorderThickness="1.5"
                                                                Background="{x:Bind CheckBackground}">
                                                                <FontIcon
                                                                    Glyph="&#xE73E;" FontSize="10"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{x:Bind IsSelected}" />
                                                            </Border>
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                Style="{StaticResource CellTextStyle}"
                                                                FontWeight="{x:Bind NameWeight}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal" Spacing="6"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsSelected}">
                                                        <Button
                                                            Tag="{x:Bind MedicineIdTag}"
                                                            Style="{StaticResource StepperButtonStyle}"
                                                            Click="EditDecrementQty_Click"
                                                            Content="−" />
                                                        <TextBlock
                                                            Text="{x:Bind QuantityDisplay}"
                                                            FontSize="13" FontWeight="SemiBold"
                                                            Foreground="#2D1554"
                                                            VerticalAlignment="Center"
                                                            MinWidth="20"
                                                            TextAlignment="Center" />
                                                        <Button
                                                            Tag="{x:Bind MedicineIdTag}"
                                                            Style="{StaticResource StepperButtonStyle}"
                                                            Click="EditIncrementQty_Click"
                                                            Content="+" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Cancel Edit row -->
                <Border x:Name="EditActionsRow" Grid.Row="3" Visibility="Collapsed" Padding="16,8,16,4">
                    <Button Click="OnCancelEditClicked"
                            Padding="10,5" Background="Transparent"
                            CornerRadius="6" BorderThickness="1" BorderBrush="#E4DAF5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#9B80C4" />
                            <TextBlock Text="Cancel Edit" FontSize="12" FontWeight="SemiBold" Foreground="#9B80C4" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Error bar -->
                <InfoBar x:Name="PrescriptionValidationBar" Grid.Row="4"
                         IsOpen="False" Severity="Error" IsClosable="False"
                         Margin="16,0,16,4" />

                <!-- Success bar -->
                <InfoBar x:Name="PrescriptionSuccessBar" Grid.Row="5"
                         IsOpen="False" Severity="Success" IsClosable="False"
                         Message="Prescription updated successfully."
                         Margin="16,0,16,12" />

            </Grid>
        </Border>

    </StackPanel>
</ContentDialog>
