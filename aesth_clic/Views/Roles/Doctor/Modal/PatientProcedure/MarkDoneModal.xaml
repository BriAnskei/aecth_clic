<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Doctor.Modals.MarkDoneModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Doctor.Modals"
    Title="Mark Procedure as Done"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClicked"
    CloseButtonClick="OnCancelClicked"
    PrimaryButtonStyle="{StaticResource PurplePrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused"                 Color="#5B2D8E" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="HorizontalAlignment"        Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StepCircleActiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#5B2D8E" />
        </Style>

        <Style x:Key="StepCircleInactiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#E4DAF5" />
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="28" />
            <Setter Property="Height"          Value="28" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"     Value="#E4DAF5" />
            <Setter Property="Background"      Value="White" />
            <Setter Property="CornerRadius"    Value="6" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Foreground"      Value="#5B2D8E" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="500">

        <!-- ── Step Indicator ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step 1 -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActiveStyle}"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="Step1Number" Text="1"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step1Label"
                           Text="Select Medicine"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#5B2D8E"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Connector Line -->
            <Border Grid.Column="1" Height="2" Width="80"
                    VerticalAlignment="Center" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="ConnectorStart" Color="#5B2D8E" Offset="0" />
                        <GradientStop x:Name="ConnectorEnd"   Color="#E4DAF5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Step 2 -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step2Circle" Style="{StaticResource StepCircleInactiveStyle}"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="Step2Number" Text="2"
                               FontSize="13" FontWeight="Bold" Foreground="#9B80C4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step2Label"
                           Text="Summary"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9B80C4"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- STEP 1 · Medicine Selection                                       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border
            x:Name="Step1Panel"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Choose Medicines"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Select the medicines to prescribe as a prescription for this procedure"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSelectedCount" Text="0 selected"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                    </Border>
                </Grid>

                <!-- Search -->
                <AutoSuggestBox
                    Grid.Row="1"
                    x:Name="MedicineSearchBox"
                    Margin="16,0,16,10"
                    PlaceholderText="Search medicine…"
                    QueryIcon="Find"
                    BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                    TextChanged="MedicineSearchBox_TextChanged" />

                <!-- Col Headers -->
                <Border Grid.Row="2" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MEDICINE" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="QUANTITY"
                                   Style="{StaticResource ColHeaderStyle}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Medicine Rows -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl x:Name="MedicineListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MedicineRowItem">
                                <StackPanel>
                                    <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                        <Grid MinHeight="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"   />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Medicine Name + Checkbox Toggle -->
                                            <Button
                                                Grid.Column="0"
                                                Tag="{x:Bind MedicineIdTag}"
                                                Style="{StaticResource RowButtonStyle}"
                                                Click="MedicineRow_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <!-- Checkbox indicator -->
                                                    <Border
                                                        Width="20" Height="20" CornerRadius="4"
                                                        BorderBrush="#C4A8E8" BorderThickness="1.5"
                                                        Background="{x:Bind CheckBackground}">
                                                        <FontIcon
                                                            Glyph="&#xE73E;" FontSize="10"
                                                            Foreground="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsSelected}" />
                                                    </Border>
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        Style="{StaticResource CellTextStyle}"
                                                        FontWeight="{x:Bind NameWeight}" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Quantity Stepper (visible only when selected) -->
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsSelected}">
                                                <Button
                                                    Tag="{x:Bind MedicineIdTag}"
                                                    Style="{StaticResource StepperButtonStyle}"
                                                    Click="DecrementQty_Click"
                                                    Content="−" />
                                                <TextBlock
                                                    x:Name="QtyDisplay"
                                                    Text="{x:Bind QuantityDisplay}"
                                                    FontSize="13" FontWeight="SemiBold"
                                                    Foreground="#2D1554"
                                                    VerticalAlignment="Center"
                                                    MinWidth="20"
                                                    TextAlignment="Center" />
                                                <Button
                                                    Tag="{x:Bind MedicineIdTag}"
                                                    Style="{StaticResource StepperButtonStyle}"
                                                    Click="IncrementQty_Click"
                                                    Content="+" />
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- STEP 2 · Summary                                                  -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border
            x:Name="Step2Panel"
            Visibility="Collapsed"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Patient + Procedure Recap -->
                <Border Grid.Row="0"
                        Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="0,0,0,1"
                        Padding="16,14" CornerRadius="10,10,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                x:Name="RecapAvatar"
                                Width="40" Height="40" CornerRadius="20"
                                Background="#5B2D8E">
                            <TextBlock x:Name="RecapInitials"
                                       FontSize="13" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Patient + Procedure info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="COMPLETING PROCEDURE FOR"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock x:Name="RecapPatientName"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="10" Foreground="#5B2D8E" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecapProcedureName"
                                               FontSize="11" Foreground="#5B2D8E" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="·" FontSize="11" Foreground="#9B80C4" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE787;" FontSize="10" Foreground="#9B80C4" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecapDate"
                                               FontSize="11" Foreground="#9B80C4" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Summary Header -->
                <Grid Grid.Row="1" Padding="16,14,16,10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Prescription Summary"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Review the medicines before marking this procedure as complete"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                </Grid>

                <!-- Col Headers -->
                <Border Grid.Row="2" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MEDICINE" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY"
                                   Style="{StaticResource ColHeaderStyle}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Selected Medicine Summary Rows -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <ItemsControl x:Name="SummaryListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SelectedMedicineSummary">
                                <StackPanel>
                                    <Border Padding="16,0">
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"  />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Spacing="8" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="#5B2D8E" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource CellTextStyle}" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#EDE4F9" CornerRadius="6"
                                                    Padding="8,3" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind QuantityDisplay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#5B2D8E"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Validation InfoBar -->
        <InfoBar x:Name="ValidationBar" IsOpen="False" Severity="Error" IsClosable="False" />

    </StackPanel>
</ContentDialog>
