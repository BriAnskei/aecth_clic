<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Receptionist.Modals.AddAppointmentModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Receptionist.Modals"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClicked"
    CloseButtonClick="OnCancelClicked"
    PrimaryButtonStyle="{StaticResource PurplePrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused"                 Color="#5B2D8E" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="HorizontalAlignment"        Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StepCircleActiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#5B2D8E" />
        </Style>

        <Style x:Key="StepCircleInactiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#E4DAF5" />
        </Style>

        <Style x:Key="StepCircleDoneStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#5B2D8E" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="520">

        <!-- ── Step Indicator ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step 1 -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActiveStyle}" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step1Number" Text="1"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step1Label" Text="Select Procedure"
                           FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Connector 1 -->
            <Border Grid.Column="1" Height="2" Width="60" VerticalAlignment="Center" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="Connector1Start" Color="#5B2D8E" Offset="0" />
                        <GradientStop x:Name="Connector1End"   Color="#E4DAF5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Step 2 -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step2Circle" Style="{StaticResource StepCircleInactiveStyle}" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step2Number" Text="2"
                               FontSize="13" FontWeight="Bold" Foreground="#9B80C4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step2Label" Text="Select Doctor"
                           FontSize="11" FontWeight="SemiBold" Foreground="#9B80C4"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Connector 2 -->
            <Border Grid.Column="3" Height="2" Width="60" VerticalAlignment="Center" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="Connector2Start" Color="#E4DAF5" Offset="0" />
                        <GradientStop x:Name="Connector2End"   Color="#E4DAF5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Step 3 -->
            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step3Circle" Style="{StaticResource StepCircleInactiveStyle}" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step3Number" Text="3"
                               FontSize="13" FontWeight="Bold" Foreground="#9B80C4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step3Label" Text="Schedule Date"
                           FontSize="11" FontWeight="SemiBold" Foreground="#9B80C4"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             STEP 1 · Select Patient Procedure
             ══════════════════════════════════════════════════════════ -->
        <Border
            x:Name="Step1Panel"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Choose a Pending Procedure"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Select the patient procedure to schedule"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProcedureCount" Text="0"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                    </Border>
                </Grid>

                <!-- Search -->
                <AutoSuggestBox
                    Grid.Row="1"
                    x:Name="ProcedureSearchBox"
                    Margin="16,0,16,10"
                    PlaceholderText="Search patient name or procedure…"
                    QueryIcon="Find"
                    BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                    TextChanged="ProcedureSearchBox_TextChanged" />

                <!-- Col Headers -->
                <Border Grid.Row="2" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PATIENT"   Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="PROCEDURE" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text=""          Style="{StaticResource ColHeaderStyle}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <ItemsControl x:Name="ProcedureListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppointmentProcedureRowItem">
                                <Button Tag="{x:Bind ProcedureRecordIdTag}"
                                        Style="{StaticResource RowButtonStyle}"
                                        Click="ProcedureRow_Click">
                                    <StackPanel>
                                        <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                            <Grid MinHeight="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"  />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar + Patient Name -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="10" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                            Background="{x:Bind AvatarColor}">
                                                        <TextBlock Text="{x:Bind Initials}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind PatientName}"
                                                               Style="{StaticResource CellTextStyle}"
                                                               FontWeight="{x:Bind NameWeight}" />
                                                </StackPanel>

                                                <!-- Procedure Name -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind ProcedureName}"
                                                           Style="{StaticResource CellSecondaryStyle}" />

                                                <!-- Checkmark -->
                                                <FontIcon Grid.Column="2"
                                                          Glyph="&#xE73E;" FontSize="13"
                                                          Foreground="#5B2D8E"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             STEP 2 · Select Doctor
             ══════════════════════════════════════════════════════════ -->
        <Border
            x:Name="Step2Panel"
            Visibility="Collapsed"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Recap: selected procedure -->
                <Border Grid.Row="0"
                        Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="0,0,0,1"
                        Padding="16,12" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="RecapStep2Avatar"
                                Width="34" Height="34" CornerRadius="17"
                                Background="#5B2D8E" Margin="0,0,10,0">
                            <TextBlock x:Name="RecapStep2Initials"
                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="SCHEDULING FOR" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock x:Name="RecapStep2PatientName"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#2D1554" />
                            <TextBlock x:Name="RecapStep2ProcedureName"
                                       FontSize="11" Foreground="#9B80C4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Header -->
                <Grid Grid.Row="1" Padding="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Choose a Doctor"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Select the doctor to assign to this appointment"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDoctorCount" Text="0"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                    </Border>
                </Grid>

                <!-- Search -->
                <AutoSuggestBox
                    Grid.Row="2"
                    x:Name="DoctorSearchBox"
                    Margin="16,0,16,10"
                    PlaceholderText="Search doctor name…"
                    QueryIcon="Find"
                    BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                    TextChanged="DoctorSearchBox_TextChanged" />

                <!-- Col Headers -->
                <Border Grid.Row="3" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DOCTOR" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text=""       Style="{StaticResource ColHeaderStyle}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                    <ItemsControl x:Name="DoctorListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppointmentDoctorRowItem">
                                <Button Tag="{x:Bind DoctorIdTag}"
                                        Style="{StaticResource RowButtonStyle}"
                                        Click="DoctorRow_Click">
                                    <StackPanel>
                                        <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                            <Grid MinHeight="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"  />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar + Name -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="10" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                            Background="#0078D4">
                                                        <TextBlock Text="{x:Bind Initials}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FullName}"
                                                               Style="{StaticResource CellTextStyle}"
                                                               FontWeight="{x:Bind NameWeight}" />
                                                </StackPanel>

                                                <!-- Checkmark -->
                                                <FontIcon Grid.Column="1"
                                                          Glyph="&#xE73E;" FontSize="13"
                                                          Foreground="#5B2D8E"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             STEP 3 · Schedule Date
             ══════════════════════════════════════════════════════════ -->
        <Border
            x:Name="Step3Panel"
            Visibility="Collapsed"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Recap: patient + procedure + doctor -->
                <Border Grid.Row="0"
                        Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="0,0,0,1"
                        Padding="16,14" CornerRadius="10,10,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Patient + Procedure -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border x:Name="RecapStep3Avatar"
                                    Width="34" Height="34" CornerRadius="17" Background="#5B2D8E">
                                <TextBlock x:Name="RecapStep3Initials"
                                           FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="PATIENT" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock x:Name="RecapStep3PatientName"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#2D1554" />
                                <TextBlock x:Name="RecapStep3ProcedureName"
                                           FontSize="11" Foreground="#9B80C4" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Grid.Column="1" Width="1" Background="#E4DAF5" Margin="0,4" />

                        <!-- Doctor -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#0078D4">
                                <TextBlock x:Name="RecapStep3DoctorInitials"
                                           FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="DOCTOR" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock x:Name="RecapStep3DoctorName"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#2D1554" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Date Picker -->
                <StackPanel Grid.Row="1" Padding="16,16" Spacing="8">
                    <TextBlock Text="APPOINTMENT DATE"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#9B80C4" CharacterSpacing="50" />
                    <CalendarDatePicker
                        x:Name="AppointmentDatePicker"
                        PlaceholderText="Select a date"
                        HorizontalAlignment="Stretch"
                        MinDate="{x:Bind TodayDate}"
                        BorderBrush="#E4DAF5"
                        CornerRadius="8" />
                    <TextBlock
                        Text="Select the date for this appointment"
                        FontSize="11" Foreground="#B0A0CC" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Validation InfoBar -->
        <InfoBar x:Name="ValidationBar" IsOpen="False" Severity="Error" IsClosable="False" />

    </StackPanel>
</ContentDialog>
