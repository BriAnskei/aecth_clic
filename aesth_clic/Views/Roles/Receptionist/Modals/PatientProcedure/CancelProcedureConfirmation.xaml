<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Receptionist.Modals.PatientProcedure.CancelProcedureConfirmation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cancel Procedure"
    PrimaryButtonText="Yes, Cancel It"
    CloseButtonText="Go Back"
    DefaultButton="Close"
    PrimaryButtonClick="OnConfirmClicked"
    PrimaryButtonStyle="{StaticResource PurplePrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="400">

        <!-- Warning Strip -->
        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="20" Background="#FFF3CD">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#F59E0B" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="This action cannot be undone."
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#B45309" />
                    <TextBlock
                        Text="Cancelling will permanently remove this procedure record."
                        FontSize="12" Foreground="#9B80C4"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Procedure Detail Card -->
        <Border Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0"
                        x:Name="PatientAvatar"
                        Width="40" Height="40" CornerRadius="20"
                        Background="#5B2D8E" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtInitials"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Patient + Procedure -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="TxtPatientName"
                               FontSize="14" FontWeight="SemiBold" Foreground="#2D1554"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtProcedureName"
                               FontSize="12" Foreground="#9B80C4"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Status + Cost -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
                    <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatus"
                                   FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="TxtCost"
                               FontSize="13" FontWeight="Bold" Foreground="#2D1554"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Confirmation Question -->
        <TextBlock
            Text="Are you sure you want to cancel this procedure?"
            FontSize="13" Foreground="#2D1554"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            TextAlignment="Center" />

    </StackPanel>
</ContentDialog>
