<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Receptionist.Modals.AddPatientProcedure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Receptionist.Modals"
    Title="Add New Procedure"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClicked"
    CloseButtonClick="OnCancelClicked"
    PrimaryButtonStyle="{StaticResource PurplePrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused"                 Color="#5B2D8E" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="HorizontalAlignment"        Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StepCircleActiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#5B2D8E" />
        </Style>

        <Style x:Key="StepCircleInactiveStyle" TargetType="Border">
            <Setter Property="Width"        Value="32" />
            <Setter Property="Height"       Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background"   Value="#E4DAF5" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="500">

        <!-- ── Step Indicator ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step 1 -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step1Circle" Style="{StaticResource StepCircleActiveStyle}"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="Step1Number" Text="1"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step1Label"
                           Text="Select Patient"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#5B2D8E"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Connector Line -->
            <Border Grid.Column="1" Height="2" Width="80"
                    VerticalAlignment="Center" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="ConnectorStart" Color="#5B2D8E" Offset="0" />
                        <GradientStop x:Name="ConnectorEnd"   Color="#E4DAF5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Step 2 -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step2Circle" Style="{StaticResource StepCircleInactiveStyle}"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="Step2Number" Text="2"
                               FontSize="13" FontWeight="Bold" Foreground="#9B80C4"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step2Label"
                           Text="Select Procedure"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9B80C4"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ── STEP 1: Patient Selection ── -->
        <Border
            x:Name="Step1Panel"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Choose a Patient"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Select the patient this procedure will be assigned to"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPatientCount" Text="0"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                    </Border>
                </Grid>

                <!-- Search -->
                <AutoSuggestBox
                    Grid.Row="1"
                    x:Name="PatientSearchBox"
                    Margin="16,0,16,10"
                    PlaceholderText="Search by name or gender…"
                    QueryIcon="Find"
                    BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                    TextChanged="PatientSearchBox_TextChanged" />

                <!-- Col Headers -->
                <Border Grid.Row="2" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAME"   Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="GENDER" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="AGE"    Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text=""       Style="{StaticResource ColHeaderStyle}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl x:Name="PatientListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PatientRowItem">
                                <Button Tag="{x:Bind PatientIdTag}"
                                        Style="{StaticResource RowButtonStyle}"
                                        Click="PatientRow_Click">
                                    <StackPanel>
                                        <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                            <Grid MinHeight="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"  />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="10" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                            Background="{x:Bind AvatarColor}">
                                                        <TextBlock Text="{x:Bind Initials}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FullName}"
                                                               Style="{StaticResource CellTextStyle}"
                                                               FontWeight="{x:Bind NameWeight}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{x:Bind Gender}"
                                                           Style="{StaticResource CellSecondaryStyle}" />

                                                <TextBlock Grid.Column="2" Text="{x:Bind AgeDisplay}"
                                                           Style="{StaticResource CellSecondaryStyle}"
                                                           Visibility="{x:Bind NotSelected}" />

                                                <FontIcon Grid.Column="3"
                                                          Glyph="&#xE73E;" FontSize="13"
                                                          Foreground="#5B2D8E"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── STEP 2: Procedure Selection ── -->
        <Border
            x:Name="Step2Panel"
            Visibility="Collapsed"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                </Grid.RowDefinitions>

                <!-- Selected Patient Recap -->
                <Border Grid.Row="0"
                        Background="#F7F4FD" BorderBrush="#E4DAF5" BorderThickness="0,0,0,1"
                        Padding="16,12" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="RecapAvatar"
                                Width="34" Height="34" CornerRadius="17"
                                Background="#5B2D8E" Margin="0,0,10,0">
                            <TextBlock x:Name="RecapInitials"
                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="ASSIGNING TO" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock x:Name="RecapPatientName"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#2D1554" />
                            <TextBlock x:Name="RecapPatientSub"
                                       FontSize="11" Foreground="#9B80C4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Header -->
                <Grid Grid.Row="1" Padding="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Choose a Procedure"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#2D1554" />
                        <TextBlock Text="Select the procedure to assign to this patient"
                                   FontSize="11" Foreground="#9B80C4" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProcedureCount" Text="0"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2D8E" />
                    </Border>
                </Grid>

                <!-- Search -->
                <AutoSuggestBox
                    Grid.Row="2"
                    x:Name="ProcedureSearchBox"
                    Margin="16,0,16,10"
                    PlaceholderText="Search procedure…"
                    QueryIcon="Find"
                    BorderBrush="#E4DAF5" BorderThickness="1" CornerRadius="8"
                    TextChanged="ProcedureSearchBox_TextChanged" />

                <!-- Col Headers -->
                <Border Grid.Row="3" Background="#F7F4FD" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="24"  />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCEDURE" Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="PRICE"     Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text=""          Style="{StaticResource ColHeaderStyle}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <ItemsControl x:Name="ProcedureListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProcedureRowItem">
                                <Button Tag="{x:Bind ProcedureIdTag}"
                                        Style="{StaticResource RowButtonStyle}"
                                        Click="ProcedureRow_Click">
                                    <StackPanel>
                                        <Border Background="{x:Bind RowBackground}" Padding="16,0">
                                            <Grid MinHeight="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"   />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="24"  />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                           Style="{StaticResource CellTextStyle}"
                                                           FontWeight="{x:Bind NameWeight}" />

                                                <TextBlock Grid.Column="1" Text="{x:Bind PriceDisplay}"
                                                           FontSize="13" FontWeight="{x:Bind NameWeight}"
                                                           Foreground="#5B2D8E"
                                                           VerticalAlignment="Center" />

                                                <FontIcon Grid.Column="2"
                                                          Glyph="&#xE73E;" FontSize="13"
                                                          Foreground="#5B2D8E"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Validation InfoBar -->
        <InfoBar x:Name="ValidationBar" IsOpen="False" Severity="Error" IsClosable="False" />

    </StackPanel>
</ContentDialog>
