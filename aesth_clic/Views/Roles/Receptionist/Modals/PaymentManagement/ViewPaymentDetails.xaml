<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="aesth_clic.Views.Roles.Receptionist.Modals.ViewPaymentDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:aesth_clic.Views.Roles.Receptionist.Modals"
    Title="Payment Details"
    CloseButtonText="Close"
    CloseButtonStyle="{StaticResource GrayCloseButtonStyle}">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground"                       Color="White" />
        <SolidColorBrush x:Key="ContentDialogBorderBrush"                      Color="#E4DAF5" />
        <SolidColorBrush x:Key="ContentDialogTopOverlayBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogButtonAreaBackground"             Color="White" />
        <SolidColorBrush x:Key="ContentDialogForeground"                       Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForeground"            Color="#5B2D8E" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPointerOver" Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonForegroundPressed"     Color="#2D1554" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackground"            Color="White" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPointerOver" Color="#EDE4F9" />
        <SolidColorBrush x:Key="ContentDialogCloseButtonBackgroundPressed"     Color="#E4DAF5" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="10" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Foreground"       Value="#9B80C4" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>

        <Style x:Key="SectionValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Foreground" Value="#2D1554" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10" />
            <Setter Property="FontWeight"        Value="SemiBold" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="CharacterSpacing"  Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Foreground"        Value="#2D1554" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellSecondaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="Foreground"        Value="#9B80C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="480">

        <!-- ── Patient Header ── -->
        <Border
            Background="#F7F4FD"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border
                    Grid.Column="0"
                    x:Name="PatientAvatar"
                    Width="46" Height="46" CornerRadius="23"
                    Background="#5B2D8E" Margin="0,0,14,0">
                    <TextBlock
                        x:Name="PatientInitials"
                        FontSize="15" FontWeight="Bold" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Name + sub -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="PatientNameText"
                        FontSize="15" FontWeight="SemiBold" Foreground="#2D1554" />
                    <TextBlock
                        x:Name="PatientSubText"
                        FontSize="11" Foreground="#9B80C4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Procedure Section ── -->
        <Border
            Background="White"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Padding="0">
            <StackPanel>
                <!-- Section title -->
                <Border Background="#F7F4FD" Padding="16,10" CornerRadius="10,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F5;" FontSize="12" Foreground="#5B2D8E" VerticalAlignment="Center" />
                        <TextBlock Text="PROCEDURE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Height="1" Background="#E4DAF5" />

                <!-- Procedure row -->
                <Grid Padding="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="PROCEDURE NAME" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="ProcedureNameText" Style="{StaticResource SectionValueStyle}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock Text="AMOUNT" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="ProcedureAmountText"
                                   FontSize="16" FontWeight="Bold" Foreground="#5B2D8E" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Prescription & Medicines Section ── -->
        <Border
            Background="White"
            BorderBrush="#E4DAF5" BorderThickness="1"
            CornerRadius="10" Padding="0">
            <StackPanel>
                <!-- Section title -->
                <Border Background="#F7F4FD" Padding="16,10" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEBE8;" FontSize="12" Foreground="#5B2D8E" VerticalAlignment="Center" />
                            <TextBlock Text="PRESCRIBED MEDICINES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EDE4F9" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtMedicineCount"
                                       Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#5B2D8E" />
                        </Border>
                    </Grid>
                </Border>
                <Border Height="1" Background="#E4DAF5" />

                <!-- Col Headers -->
                <Border Background="#FDFBFF" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   />
                            <ColumnDefinition Width="70"  />
                            <ColumnDefinition Width="80"  />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MEDICINE"  Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY"       Style="{StaticResource ColHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="UNIT"      Style="{StaticResource ColHeaderStyle}" />
                    </Grid>
                </Border>
                <Border Height="1" Background="#F0EAF8" />

                <!-- Medicine Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <ItemsControl x:Name="MedicineListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MedicineRowItem">
                                <StackPanel>
                                    <Border Padding="16,0">
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"   />
                                                <ColumnDefinition Width="70"  />
                                                <ColumnDefinition Width="80"  />
                                            </Grid.ColumnDefinitions>

                                            <!-- Medicine name + pill icon -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Spacing="8" VerticalAlignment="Center">
                                                <Border
                                                    Width="26" Height="26" CornerRadius="8"
                                                    Background="#EDE4F9">
                                                    <FontIcon Glyph="&#xEBE8;" FontSize="11"
                                                              Foreground="#5B2D8E"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock
                                                    Text="{x:Bind MedicineName}"
                                                    Style="{StaticResource CellTextStyle}"
                                                    FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Qty -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind QuantityDisplay}"
                                                       Style="{StaticResource CellTextStyle}" />

                                            <!-- Unit -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Unit}"
                                                       Style="{StaticResource CellSecondaryStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="#F0EAF8" Margin="16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </StackPanel>
        </Border>

    </StackPanel>
</ContentDialog>
